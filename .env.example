# Trunkline Environment Configuration Template
# Copy this file to .env and update the values for your environment
#
# ⚠️ SECURITY: This template deliberately contains NO usable credentials.
#    A placeholder that is long enough to pass the 32-character check is still a
#    publicly known secret — copying it verbatim would let anyone forge tokens.
#    StartupSecurityGate rejects "your-* / change-* / replace-* / example-*" secrets.
#    Generate real values first: openssl rand -base64 32

# ===========================================
# JWT Configuration (REQUIRED for production)
# ===========================================

# JWT Secret Key - MUST be at least 32 characters and MUST be explicitly set in production
# Generate with: openssl rand -base64 32
# Leaving this empty is safe for local dev: StartupSecurityEnvironmentPostProcessor
# generates a random secret and persists it to ./data/jwt-secret (reused on restart).
# In prod, the startup gate fails fast until one of these is set:
#   JWT_SECRET / PROD_JWT_SECRET / DEV_JWT_SECRET (checked in that order)
JWT_SECRET=

# JWT Token Expiration (in minutes)
# Recommended: 15 minutes for production, 60 for development
JWT_EXPIRATION_MINUTES=15

# JWT Refresh Token Expiration (in days)
# Recommended: 30 days for production, 7 days for development
JWT_REFRESH_EXPIRATION_DAYS=30

# JWT Issuer (optional)
JWT_ISSUER=trunkline

# ===========================================
# Initial Admin Configuration (REQUIRED for first startup)
# ===========================================

# Initial Admin Password - MUST be set for first startup
# ⚠️ SECURITY WARNING: Change after first login
# Generate with: openssl rand -base64 24
# 管理员账号不再来自环境变量：首次启动访问 /init（jar 部署为 /admin/init）走向导创建

# ===========================================
# API Keys for External Services
# ===========================================

# GPUStack API Token (for model services)
# ⚠️ SECURITY WARNING: Never hardcode in config files
GPUSTACK_API_TOKEN=

# OpenAI API Key (optional, for OpenAI adapter)
OPENAI_API_KEY=

# Anthropic API Key (optional, for Claude adapter)
ANTHROPIC_API_KEY=

# ===========================================
# Redis Configuration
# ===========================================

# Redis Host
REDIS_HOST=redis

# Redis Port
REDIS_PORT=6379

# Redis Password (REQUIRED for production)
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=

# ===========================================
# Application Configuration
# ===========================================

# Spring Profile (dev, prod, migrate)
SPRING_PROFILES_ACTIVE=prod

# Server Port
SERVER_PORT=8080

# ===========================================
# Security Configuration
# ===========================================

# Enable JWT token-ledger persistence (true/false)
# Default false matches the single source of truth in
# src/main/resources/config/security/persistence-base.yml.
# Turning it on assembles extra persistence/cleanup beans — verify a full context
# startup before enabling. Revoked tokens (blacklist) are persisted by the
# StoreManager @Bean regardless of this switch.
JWT_PERSISTENCE_ENABLED=false
# Enable the component-scanned blacklist service implementation (true/false)
JWT_BLACKLIST_PERSISTENCE_ENABLED=false

# Enable Security Audit (true/false)
SECURITY_AUDIT_ENABLED=true

# Security Audit Retention (in days)
SECURITY_AUDIT_RETENTION_DAYS=180

# ===========================================
# Monitoring Configuration
# ===========================================

# Grafana Admin Credentials
# Change both before exposing Grafana beyond localhost
GRAFANA_USER=
GRAFANA_PASSWORD=

# Prometheus Retention
PROMETHEUS_RETENTION=30d

# ===========================================
# Database Configuration (Optional)
# ===========================================

# External database for audit logs (defaults to embedded H2 if unset)
# DATABASE_URL=jdbc:postgresql://localhost:5432/trunkline
# DATABASE_USERNAME=trunkline
# DATABASE_PASSWORD=your-database-password

# ===========================================
# Performance Configuration
# ===========================================

# JVM Memory Settings
# Do NOT set -Xmx here: a fixed heap overrides MaxRAMPercentage and can be
# OOM-killed when the container limit is smaller than the fixed value.
JAVA_OPTS=-XX:+UseG1GC -XX:+UseContainerSupport -XX:InitialRAMPercentage=50.0 -XX:MaxRAMPercentage=75.0

# ===========================================
# Development Configuration
# ===========================================

# Debug Port (for development)
DEBUG_PORT=5005

# Log Level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ===========================================
# Backup Configuration
# ===========================================

# Backup Directory
BACKUP_DIR=/backup/trunkline

# Backup Retention (in days)
BACKUP_RETENTION_DAYS=30

# ===========================================
# Network Configuration
# ===========================================

# External URL (for production)
EXTERNAL_URL=https://trunkline.example.com

# Allowed Origins (for CORS)
ALLOWED_ORIGINS=https://trunkline.example.com,https://admin.trunkline.example.com

# ===========================================
# SSL/TLS Configuration
# ===========================================

# SSL Certificate Path
SSL_CERT_PATH=/etc/ssl/certs/trunkline.crt
SSL_KEY_PATH=/etc/ssl/private/trunkline.key

# ===========================================
# High Availability Configuration
# ===========================================

# Instance ID (for multi-instance deployment)
INSTANCE_ID=1

# Cluster Nodes (comma-separated)
CLUSTER_NODES=trunkline-1:8080,trunkline-2:8080,trunkline-3:8080

# ===========================================
# Notification Configuration
# ===========================================

# Email Configuration (for alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=

# Webhook URL (for alerts)
WEBHOOK_URL=http://webhook-server:5001/webhook
