# 单阶段构建 Dockerfile for Trunkline
FROM eclipse-temurin:17-jre
ARG VERSION

# 设置维护者信息
LABEL maintainer="Trunkline Team"
LABEL description="Trunkline - AI Governance Gateway"
LABEL version="${VERSION}"

# 创建应用用户（安全最佳实践）
RUN groupadd -r -g 10010 trunkline && \
    useradd -r -u 10010 -g 10010 trunkline

# 设置工作目录
WORKDIR /app

# 创建必要的目录
RUN mkdir -p /app/logs /app/config /app/config-store /app/config-dev /app/data && \
    chown -R trunkline:trunkline /app  && \
    chmod -R 766 /app

# 直接复制外部构建好的 JAR 文件（精确版本，避免 target/ 残留旧版本 jar 被误选）
COPY target/trunkline-${VERSION}.jar app.jar
RUN chown trunkline:trunkline app.jar

# 配置文件通过卷挂载提供，无需复制到镜像中

# 设置 JVM 参数（容器感知）：不设 -Xms/-Xmx，避免固定堆压过 MaxRAMPercentage。
ENV JAVA_OPTS="-XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0"

# 设置应用参数
ENV SPRING_PROFILES_ACTIVE=prod
ENV SERVER_PORT=8080

# 安全功能相关环境变量
ENV TRUNKLINE_SECURITY_ENABLED=true
ENV TRUNKLINE_SECURITY_API_KEY_ENABLED=true
ENV TRUNKLINE_SECURITY_JWT_ENABLED=true
ENV TRUNKLINE_SECURITY_SANITIZATION_REQUEST_ENABLED=true
ENV TRUNKLINE_SECURITY_SANITIZATION_RESPONSE_ENABLED=true
ENV TRUNKLINE_SECURITY_AUDIT_ENABLED=true

# API Key 配置环境变量
ENV ADMIN_API_KEY=""
ENV USER_API_KEY=""

# JWT 配置环境变量（与主 Dockerfile 一致：不设置空值）
# ENV JWT_SECRET=""
ENV JWT_ALGORITHM=HS256
ENV JWT_EXPIRATION_MINUTES=60

# Redis 缓存配置环境变量
ENV REDIS_HOST=localhost
ENV REDIS_PORT=6379
ENV REDIS_PASSWORD=""
ENV REDIS_DATABASE=0
ENV REDIS_TIMEOUT=2000

# 暴露端口
EXPOSE 8080

# 切换到应用用户
USER trunkline

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# 启动应用
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar \"$@\"", "--"]
