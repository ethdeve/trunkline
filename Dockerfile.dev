# 开发环境 Dockerfile for Trunkline
FROM eclipse-temurin:17-jdk-alpine
ARG VERSION

# 设置维护者信息
LABEL maintainer="Trunkline Team"
LABEL description="Trunkline Development Environment"
LABEL version="${VERSION}"

# 安装必要的工具
RUN apk add --no-cache curl wget

# 创建应用用户（安全最佳实践）
RUN groupadd -r -g 10010 trunkline && \
    useradd -r -u 10010 -g 10010 trunkline

# 设置工作目录
WORKDIR /app

# 创建必要的目录
RUN mkdir -p /app/logs /app/config /app/config-store /app/data && \
    chown -R trunkline:trunkline /app

# 复制应用 JAR 文件（精确版本，避免 target/ 残留旧版本 jar 被误选）
COPY target/trunkline-${VERSION}.jar app.jar
RUN chown trunkline:trunkline app.jar

# 配置文件通过卷挂载提供，无需复制到镜像中

# 设置 JVM 参数（开发环境）
# 开发环境有意保留固定堆：本地调试需要可预测的堆大小与 jdwp 调试端口，
# 不走容器自适应；生产镜像见 Dockerfile 等，均已移除 -Xms/-Xmx。
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"

# 设置应用参数
ENV SPRING_PROFILES_ACTIVE=dev
ENV SERVER_PORT=8080

# 暴露端口（应用端口 + 调试端口）
EXPOSE 8080 5005

# 切换到应用用户
USER trunkline

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# 启动应用
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar \"$@\"", "--"]
