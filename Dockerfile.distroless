# Trunkline Distroless 版本 Dockerfile
# 使用 Google Distroless 基础镜像，最小化攻击面
# 镜像大小: ~180MB (比标准版减少 50%+)
# 
# 注意: Distroless 没有 shell，无法使用健康检查命令
# 建议使用 Kubernetes liveness/readiness probe
#
# 构建命令: docker build --build-arg VERSION=0.1.0 -f Dockerfile.distroless -t trunkline:distroless .
# 运行命令: docker run -p 8080:8080 -e JWT_SECRET=your-secret trunkline:distroless
# VERSION 必须与 pom.xml 的 project.version 一致（决定 jar 名与镜像 LABEL）。

# =============================================================================
# 阶段 1: 提取 Spring Boot 分层内容
# =============================================================================
FROM eclipse-temurin:17-jdk-alpine AS extract-layer
ARG VERSION

WORKDIR /app

# 复制 JAR 文件（精确版本，避免 target/ 残留旧版本 jar 被误选）
COPY target/trunkline-${VERSION}.jar app.jar

# 使用 Spring Boot 工具提取分层（利用 Docker 缓存）
RUN java -Djarmode=layertools -jar app.jar extract --destination extracted

# =============================================================================
# 阶段 2: 最终运行镜像 (Distroless)
# =============================================================================
FROM gcr.io/distroless/java17-debian12:latest
ARG VERSION

# 设置元数据
LABEL maintainer="Trunkline Team"
LABEL description="Trunkline - AI Governance Gateway (Distroless)"
LABEL version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/wjy2027/trunkline"

WORKDIR /app

# 复制 Spring Boot 分层内容
# 注意: Distroless 默认使用 nonroot 用户 (uid=65532)
COPY --from=extract-layer /app/extracted/dependencies/ ./
COPY --from=extract-layer /app/extracted/spring-boot-loader/ ./
COPY --from=extract-layer /app/extracted/snapshot-dependencies/ ./
COPY --from=extract-layer /app/extracted/application/ ./

# 环境变量（Distroless 不支持 ENV 指令设置 JAVA_OPTS）
# 通过 Kubernetes/运行时传入

EXPOSE 8080

# 注意: Distroless 没有 shell，健康检查需要在 Kubernetes 层面实现
# 建议配置:
# livenessProbe:
#   httpGet:
#     path: /actuator/health/liveness
#     port: 8080
# readinessProbe:
#   httpGet:
#     path: /actuator/health/readiness
#     port: 8080

# 启动应用（Distroless 入口点已配置为 java）
# 不设 -Xms/-Xmx：固定堆会压过 MaxRAMPercentage，使容器 limits 失效。
ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-XX:InitialRAMPercentage=50.0", "org.springframework.boot.loader.launch.JarLauncher"]
