# Trunkline 优化版 Dockerfile
# 多阶段构建 + Alpine 基础镜像 + Spring Boot 分层
# 镜像大小: ~200MB (比标准版减少 40%+)
#
# 构建命令: docker build --build-arg VERSION=0.1.0 -f Dockerfile.optimized -t trunkline:optimized .
# 运行命令: docker run -p 8080:8080 -e JWT_SECRET=your-secret trunkline:optimized
# VERSION 必须与 pom.xml 的 project.version 一致（决定 jar 名与镜像 LABEL）。

# =============================================================================
# 阶段 1: 提取 Spring Boot 分层内容
# =============================================================================
FROM eclipse-temurin:17-jre-alpine AS extract-layer
ARG VERSION

WORKDIR /app

# 复制 JAR 文件（精确版本，避免 target/ 残留旧版本 jar 被误选）
COPY target/trunkline-${VERSION}.jar app.jar

# 使用 Spring Boot 工具提取分层（利用 Docker 缓存）
RUN java -Djarmode=layertools -jar app.jar extract --destination extracted

# =============================================================================
# 阶段 2: 最终运行镜像
# =============================================================================
FROM eclipse-temurin:17-jre-alpine
ARG VERSION

# 设置元数据
LABEL maintainer="Trunkline Team"
LABEL description="Trunkline - AI Governance Gateway"
LABEL version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/wjy2027/trunkline"

# 安装必要工具（wget 用于健康检查，tzdata 用于时区支持）
RUN apk add --no-cache wget tzdata && \
    rm -rf /var/cache/apk/*

# 创建非 root 用户（安全最佳实践）
RUN addgroup -g 10010 -S trunkline && \
    adduser -u 10010 -S trunkline -G trunkline

WORKDIR /app

# 创建数据目录
RUN mkdir -p /app/logs /app/config /app/config-store /app/data && \
    chown -R trunkline:trunkline /app && \
    chmod -R 755 /app

# 复制 Spring Boot 分层内容（按层复制以利用缓存）
COPY --from=extract-layer --chown=trunkline:trunkline /app/extracted/dependencies/ ./
COPY --from=extract-layer --chown=trunkline:trunkline /app/extracted/spring-boot-loader/ ./
COPY --from=extract-layer --chown=trunkline:trunkline /app/extracted/snapshot-dependencies/ ./
COPY --from=extract-layer --chown=trunkline:trunkline /app/extracted/application/ ./

# JVM 优化参数（容器感知）：不设 -Xms/-Xmx，避免固定堆压过 MaxRAMPercentage。
ENV JAVA_OPTS="-XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=20"

# 应用配置
ENV SPRING_PROFILES_ACTIVE=prod
ENV SERVER_PORT=8080

EXPOSE 8080

USER trunkline

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# 启动应用
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS org.springframework.boot.loader.launch.JarLauncher \"$@\"", "--"]
