<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>org.unreal</groupId>
    <artifactId>trunkline</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>trunkline</name>
    <url>http://maven.apache.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <docker.image.prefix>trunkline</docker.image.prefix>
        <docker.image.name>${docker.image.prefix}/${project.artifactId}</docker.image.name>
        <opentelemetry.version>1.35.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>1.32.0</opentelemetry-instrumentation.version>
        <!-- 默认启用前端构建，使用 -Pfast 或 -Dfrontend.build.skip=true 跳过 -->
        <frontend.build.skip>false</frontend.build.skip>
        <!-- 构建优化配置 -->
        <maven.test.skip>false</maven.test.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <!-- 单一基线护栏（闸门⑥）：默认开启 V1__baseline.sql 哈希校验；本地快速构建可 -Dv1.guard.skip=true -->
        <v1.guard.skip>false</v1.guard.skip>
    </properties>

    <profiles>
        <!-- Docker 构建 Profile -->
        <profile>
            <id>docker</id>
            <properties>
                <maven.test.skip>true</maven.test.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.spotify</groupId>
                        <artifactId>dockerfile-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>push-image</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>push</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Jib 构建 Profile -->
        <profile>
            <id>jib</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.google.cloud.tools</groupId>
                        <artifactId>jib-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>dockerBuild</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 开发环境 Profile -->
        <profile>
            <id>dev</id>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
                <checkstyle.skip>true</checkstyle.skip>
                <spotbugs.skip>true</spotbugs.skip>
                <jacoco.skip>true</jacoco.skip>
            </properties>
        </profile>

        <!-- 生产环境 Profile -->
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
                <maven.test.skip>true</maven.test.skip>
                <checkstyle.skip>true</checkstyle.skip>
                <spotbugs.skip>true</spotbugs.skip>
                <jacoco.skip>true</jacoco.skip>
                <!-- 生产环境启用前端构建 -->
                <frontend.build.skip>false</frontend.build.skip>
            </properties>
        </profile>

        <!-- 前端构建 Profile -->
        <profile>
            <id>frontend</id>
            <properties>
                <frontend.build.skip>false</frontend.build.skip>
            </properties>
        </profile>

        <!-- 快速构建 Profile - 跳过代码质量检查 -->
        <profile>
            <id>fast</id>
            <properties>
                <maven.test.skip>true</maven.test.skip>
                <checkstyle.skip>true</checkstyle.skip>
                <spotbugs.skip>true</spotbugs.skip>
                <jacoco.skip>true</jacoco.skip>
                <!-- 快速构建跳过前端构建 -->
                <frontend.build.skip>true</frontend.build.skip>
            </properties>
        </profile>

        <!-- 中国加速 Profile - 使用阿里云Maven镜像 -->
        <profile>
            <id>china</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
                <maven.test.skip>true</maven.test.skip>
                <checkstyle.skip>true</checkstyle.skip>
                <spotbugs.skip>true</spotbugs.skip>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <repositories>
                <repository>
                    <id>aliyun-central</id>
                    <name>Alibaba Central Repository</name>
                    <url>https://maven.aliyun.com/repository/central</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>aliyun-spring</id>
                    <name>Alibaba Spring Repository</name>
                    <url>https://maven.aliyun.com/repository/spring</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
                <repository>
                    <id>aliyun-public</id>
                    <name>Alibaba Public Repository</name>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>aliyun-plugin</id>
                    <name>Alibaba Plugin Repository</name>
                    <url>https://maven.aliyun.com/repository/central</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>aliyun-spring-plugin</id>
                    <name>Alibaba Spring Plugin Repository</name>
                    <url>https://maven.aliyun.com/repository/spring-plugin</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>


    <dependencyManagement>
        <dependencies>
            <!-- OpenTelemetry BOM for version management -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- O8-4 租户跨线程传播：micrometer-core 对本依赖是 optional，不会进 fat jar；
             企业版 TenantContextPropagationConfiguration 需要 Hooks.enableAutomaticContextPropagation()，
             显式声明使其随运行时分发（版本由 Boot 3.5 parent 管理）。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>2.8.13</version>
        </dependency>

        <!-- Spring Security WebFlux for reactive security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT support -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis for caching (optional, for API key and JWT blacklist caching) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Caffeine for local caching (v2.7.10: client IP rate limiter cache) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- JMH for microbenchmarking (v2.7.13: performance testing) -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>

        <!-- Lombok for reducing boilerplate code -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Security Test -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- OpenTelemetry Core API -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!-- OpenTelemetry SDK -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>

        <!-- OpenTelemetry Auto Configuration -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
        </dependency>

        <!-- OpenTelemetry Semantic Conventions -->
        <dependency>
            <groupId>io.opentelemetry.semconv</groupId>
            <artifactId>opentelemetry-semconv</artifactId>
            <version>1.21.0-alpha</version>
        </dependency>

        <!-- OpenTelemetry Jaeger Exporter - 已移除，使用 OTLP 替代 -->
        <!-- Jaeger 现在推荐使用 OTLP 协议，不再需要单独的 Jaeger exporter -->

        <!-- OpenTelemetry Zipkin Exporter -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-zipkin</artifactId>
        </dependency>

        <!-- OpenTelemetry OTLP Exporter -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- OpenTelemetry Logging Exporter (for development) -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-logging</artifactId>
        </dependency>

        <!-- Logstash Logback Encoder for structured JSON logging -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!-- H2 Database for embedded storage -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          PostgreSQL 驱动：横向扩展（多副本）需要外部共享数据库，H2 嵌入式单文件库不可共享。
          默认仍为 H2（见 config/config-service/core.yml 的 DATABASE_URL 默认值），
          仅在显式设置 DATABASE_URL=jdbc:postgresql://… 时才走 PostgreSQL。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          版本化 schema 迁移（issue #191 / #192）：PostgreSQL 与 H2 两条路径都启用，各用自己方言的
          脚本目录；只有 PostgreSQL 同时把 ddl-auto 覆盖为 validate。按数据源 URL 判定，
          见 FlywayDialectEnvironmentPostProcessor。
          flyway-database-postgresql 是 Flyway 10+ 拆出的 PostgreSQL 支持模块，缺它会在
          初始化时报 "Unsupported Database: PostgreSQL"。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Data JPA for database access (v1.5.1: replaced R2DBC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                      3.5 实测事实（loader-tools 3.5.16 反编译核验）：
                      - loaderImplementation 枚举只有 DEFAULT / CLASSIC，选的是「loader 体系」，
                        不存在 PROPERTIES_LOADER / PROPERTIES 值；
                      - 新式 loader 的 PropertiesLauncher 只认 loader.home/main/args/classLoader，
                        不支持 loader.path —— 插件目录式部署必须用 classic loader；
                      - CLASSIC 体系内嵌 spring-boot-loader-classic.jar（repackage 后展开在
                        fat jar 根部）：含 classic JarLauncher / PropertiesLauncher（支持
                        loader.path）及 launch.* 桥接类，java -jar 的 Main-Class
                        （launch.JarLauncher 桥接 → classic JarLauncher）不受影响，
                        社区 Dockerfile 的 jarmode=tools 入口同样可用。
                      商业版两种部署形态（trunkline-enterprise/deploy/README.md）：
                        A. 烤入式 —— 企业 jar 放进 BOOT-INF/lib，java -jar 直接跑；
                        B. 插件目录式 —— java -Dloader.path=./plugins -cp trunkline.jar
                           org.springframework.boot.loader.PropertiesLauncher
                    -->
                    <loaderImplementation>CLASSIC</loaderImplementation>
                </configuration>
            </plugin>

            <!-- O10：把 repackage 前的原始 jar 以 classifier=normal attached 发布，
                 让 trunkline-enterprise 可以直接以 <classifier>original</classifier> 声明编译依赖，
                 消除手工 install-file 步骤。
                 注意执行顺序：本插件必须声明在 spring-boot-maven-plugin 之后（同 phase 内
                 按声明顺序执行，repackage 先生成 .original，本插件才能 attach 到它）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-original-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/${project.build.finalName}.jar.original</file>
                                    <type>jar</type>
                                    <classifier>original</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 单一基线护栏（闸门⑥）：任何构建都校验 h2 / postgres 两份 V1__baseline.sql
                 哈希与 db/migration/v1-baseline.sha256 一致。V1 被改动会破坏已部署客户的
                 Flyway checksum，故在 validate 阶段 fail-fast。本地快速构建可 -Dv1.guard.skip=true。
                 哈希值须与 v1-baseline.sha256 保持同步；用内建 Ant <checksum> 任务，避免派生
                 外部 shell（wsl 在部分环境被安全策略拦截）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-v1-baseline</id>
                        <phase>validate</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <skip>${v1.guard.skip}</skip>
                            <target>
                                <checksum file="${project.basedir}/src/main/resources/db/migration/h2/V1__baseline.sql"
                                         property="v1.h2.hash" algorithm="SHA-256"/>
                                <checksum file="${project.basedir}/src/main/resources/db/migration/postgres/V1__baseline.sql"
                                         property="v1.pg.hash" algorithm="SHA-256"/>
                                <condition property="v1.ok">
                                    <and>
                                        <equals arg1="${v1.h2.hash}" arg2="b9e41a35c2403be5509fe85ad26f4f2f26d0c9973819cd0352fa3c2aac4d906e"/>
                                        <equals arg1="${v1.pg.hash}" arg2="c84f040efd6640376bb312ed02610622bc3c5f9286e619b5744572d8fbc75ede"/>
                                    </and>
                                </condition>
                                <fail unless="v1.ok"
                                      message="V1__baseline.sql 哈希失配：单一基线被改动，已部署客户将 Flyway checksum 失配、启动失败。已发布则必须改为新增 V4__&lt;desc&gt;.sql 增量迁移；未发布且确认无客户则同步更新 db/migration/v1-baseline.sha256（哈希须与 pom 内校验值一致）。"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Surefire Plugin：JDK 21+ 需显式允许动态 agent 加载，
                 否则 Mockito inline mock maker 的 byte-buddy 自挂载会失败
                 （部分环境对外部 attach 进程创建有限制，见 S1 记录） -->
            <!-- 锁定 3.5.3：3.5.4+ 的 provider 级类名过滤回归（surefire #3179/#3446 系列）
                 导致 JUnit5 @Nested 测试类在全量/定向运行中静默不执行
                 （2026-11-12 parent 3.5.5→3.5.16 连带 surefire 3.5.3→3.5.6 后，
                 764 个 Nested 报告不再生成、测试门禁实际失效）。
                 升级前必须先验证 @Nested 恢复执行。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                        <!-- JMH annotation processor for benchmark generation -->
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>1.37</version>
                        </path>
                    </annotationProcessorPaths>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!-- Checkstyle Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <!-- E-04：severity=warning 原配置永不阻断；改为「warning 也算违规 + 基线封顶」，
                         存量 137 条只减不增，新增违规立即红构建。 -->
                    <violationSeverity>warning</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <maxAllowedViolations>137</maxAllowedViolations>
                    <linkXRef>false</linkXRef>
                    <propertyExpansion>config_loc=${basedir}/config</propertyExpansion>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>9.3</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- SpotBugs Plugin -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.3.2</version>
                <configuration>
                    <effort>Default</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <includeFilterFile>spotbugs-security-include.xml</includeFilterFile>
                    <excludeFilterFile>spotbugs-security-exclude.xml</excludeFilterFile>
                    <maxRank>15</maxRank>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.4.0</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>analyze-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>COMPLEXITY</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 基线实测 0.30（4014 个测试全过前提下），0.60 为上游期望值；
                                                 自研扩展后逐步回调至 0.40，避免门槛虚高阻断构建 -->
                                            <minimum>0.30</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Docker Maven Plugin -->
            <plugin>
                <groupId>com.spotify</groupId>
                <artifactId>dockerfile-maven-plugin</artifactId>
                <version>1.4.13</version>
                <configuration>
                    <repository>trunkline/${project.artifactId}</repository>
                    <tag>${project.version}</tag>
                    <buildArgs>
                        <JAR_FILE>target/${project.build.finalName}.jar</JAR_FILE>
                        <VERSION>${project.version}</VERSION>
                    </buildArgs>
                    <useMavenSettingsForAuth>true</useMavenSettingsForAuth>
                    <pullNewerImage>false</pullNewerImage>
                    <noCache>false</noCache>
                </configuration>
            </plugin>

            <!--
                Frontend Maven Plugin - 前端构建插件
                默认情况下跳过前端构建以提高开发效率
                使用方法:
                1. mvn clean package -Pfrontend  - 启用前端构建
                2. mvn clean package -Pprod      - 生产环境（自动启用前端构建）
                3. mvn clean package -Pfast      - 快速构建（跳过前端）
                4. mvn clean package -Dfrontend.build.skip=false  - 命令行启用前端
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>frontend/</workingDirectory>
                    <installDirectory>target</installDirectory>
                    <!-- 通过属性控制是否跳过，默认跳过 -->
                    <!--suppress UnresolvedMavenProperty -->
                    <skip>${frontend.build.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v22.14.0</nodeVersion>
                            <npmVersion>11.2.0</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm run build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy frontend build to static resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-build</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static/admin</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Jib Plugin (Alternative Docker plugin) -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <from>
                        <image>eclipse-temurin:17-jre</image>
                    </from>
                    <to>
                        <image>trunkline/${project.artifactId}:${project.version}</image>
                        <tags>
                            <tag>latest</tag>
                        </tags>
                    </to>
                    <container>
                        <!-- 与 Dockerfile 对齐：不设 -Xms/-Xmx，交给 MaxRAMPercentage 按容器 limits 伸缩 -->
                        <jvmFlags>
                            <jvmFlag>-XX:+UseG1GC</jvmFlag>
                            <jvmFlag>-XX:+UseContainerSupport</jvmFlag>
                            <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                            <jvmFlag>-XX:InitialRAMPercentage=50.0</jvmFlag>
                        </jvmFlags>
                        <!-- Jib 不走 Dockerfile，镜像版本标签须在此单独声明 -->
                        <labels>
                            <version>${project.version}</version>
                        </labels>
                        <environment>
                            <SPRING_PROFILES_ACTIVE>prod</SPRING_PROFILES_ACTIVE>
                        </environment>
                        <ports>
                            <port>8080</port>
                        </ports>
                        <user>1001:1001</user>
                        <workingDirectory>/app</workingDirectory>
                        <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                    </container>
                    <extraDirectories>
                        <paths>
                            <path>
                                <from>config</from>
                                <into>/app/config</into>
                            </path>
                        </paths>
                        <permissions>
                            <permission>
                                <file>/app/config</file>
                                <mode>755</mode>
                            </permission>
                        </permissions>
                    </extraDirectories>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
