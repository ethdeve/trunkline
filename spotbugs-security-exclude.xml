<FindBugsFilter>
    <!-- 排除日志CRLF注入警告 - 这些是内部系统日志，风险可控 -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    
    <!-- 排除Spring相关的误报 -->
    <Match>
        <Bug pattern="SPRING_ENTITY_LEAK"/>
    </Match>
    
    <!-- 排除泛型相关的误报 -->
    <Match>
        <Class name="~.*Controller"/>
        <Bug pattern="SPRING_ENTITY_LEAK"/>
    </Match>
    
    <!-- 排除测试类的安全检查 -->
    <Match>
        <Class name="~.*Test"/>
    </Match>
    
    <!-- 排除DTO类的某些检查 -->
    <Match>
        <Class name="~.*\.dto\..*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    
    <!-- 排除配置类的某些检查 -->
    <Match>
        <Class name="~.*\.model\.ModelRouterProperties.*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    
    <!-- 排除响应类的某些检查 -->
    <Match>
        <Class name="~.*\.response\..*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    
    <!-- 排除工具类的某些检查 -->
    <Match>
        <Class name="~.*\.util\..*"/>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>
    
    <!-- 排除Spring Boot应用主类 -->
    <Match>
        <Class name="~.*Application"/>
        <Bug pattern="DM_EXIT"/>
    </Match>
    
    <!-- 排除一些常见的低风险问题 -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    
    <!-- 排除FindBugs对lambda表达式的误报 -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>
    
    <!-- 排除对Builder模式的误报 -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>
    
    <!-- 排除健康检查中的未加密Socket警告 - 这是内部健康检查，不需要加密 -->
    <Match>
        <Class name="org.unreal.modelrouter.common.util.NetUtils"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>
    
<!--
    E-03：不再全局排除 REDOS / PATH_TRAVERSAL_IN。以下 4 处是评审逐行确认过的存量白名单
    （按类名精确限定，新增代码在其它类仍会被扫描拦截）：
    - PathSanitizer 自身就是路径净化器，File(入参) 是唯一职责；
    - FileStoreManager 所有用户路径经 PathSanitizer 校验后才构造 File；
    - ConfigurationValidator / ConfigValidatorHelper 的域名正则为有界标签结构，
      已由配置写入侧长度上限收口。
    新增同类问题请修代码，不要在此追加类。
-->
    <Match>
        <Class name="org.unreal.modelrouter.common.util.PathSanitizer"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
    <Match>
        <Class name="org.unreal.modelrouter.persistence.store.FileStoreManager"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
    <Match>
        <Class name="org.unreal.modelrouter.config.core.ConfigurationValidator"/>
        <Bug pattern="REDOS"/>
    </Match>
    <Match>
        <Class name="org.unreal.modelrouter.config.core.helper.ConfigValidatorHelper"/>
        <Bug pattern="REDOS"/>
    </Match>

    <!-- 排除可预测随机数警告 - 负载均衡不需要加密级别的随机性 -->
    <Match>
        <Class name="org.unreal.modelrouter.router.loadbalancer.impl.RandomLoadBalancer"/>
        <Bug pattern="PREDICTABLE_RANDOM"/>
    </Match>
</FindBugsFilter>
